---
import { hinweise } from '../data/hinweise';
import { praxis } from '../data/praxis';
import MainLayout from '../layouts/MainLayout.astro';

const buildZeitpunkt = Date.now();
const istAktuell = (sichtbarAb: string, sichtbarBis: string) =>
  buildZeitpunkt >= Date.parse(sichtbarAb) && buildZeitpunkt < Date.parse(sichtbarBis);

const leitbild = [
  {
    title: 'Drei Generationen, eine Praxis',
    text: 'Manche unserer Patientinnen und Patienten kennen wir, seit sie selbst noch Kinder waren – und behandeln inzwischen schon ihre eigenen Kinder oder Enkel. Wir sehen nicht nur Befunde und Werte, sondern Menschen mit einer Geschichte. Wer zu uns kommt, muss nicht immer alles von Anfang an erzählen – wir wissen oft schon, woher jemand kommt und was ihn beschäftigt.'
  },
  {
    title: 'Vertrauen, das über Jahre wächst',
    text: 'Diese Verbindung über Generationen hinweg ist für uns eine Verantwortung, die wir ernst nehmen. Sie bedeutet, dass wir uns Zeit nehmen, zuhören und nachfragen – auch dann, wenn ein Termin eng getaktet ist. Gleichzeitig bleiben wir fachlich auf dem aktuellen Stand, bilden uns regelmäßig fort und passen unsere Abläufe an, wenn wir merken, dass es besser geht.'
  },
  {
    title: 'Miteinander statt nebeneinander',
    text: 'Eine Praxis mit langer Geschichte lebt von einem Team, das zusammenhält. Wir gehen offen miteinander um, unterstützen uns gegenseitig und sprechen Probleme an, statt sie zu verschweigen. Nur so können wir die Qualität halten, die unsere Patientinnen und Patienten seit Jahrzehnten von uns erwarten.'
  },
  {
    title: 'Erreichbar, wenn es zählt',
    text: 'Gerade bei dringenden Anliegen wissen unsere Patientinnen und Patienten: Hier werden wir gehört. Wir sind gut erreichbar, bemühen uns um zeitnahe Termine und finden auch kurzfristig eine Lösung, wenn es nötig ist.'
  }
];

const leistungen = [
  'Laboruntersuchungen',
  'EKG',
  'Langzeit-Blutdruckmessung',
  'Lungenfunktionstest',
  'Schellong-Test',
  'Impfungen',
  'Wundversorgung',
  'Ohrspülung (IGeL-Leistung)',
  'Früherkennungsuntersuchungen für Kinder und Jugendliche (U1–U9, J1)',
  'Gesundheitsuntersuchung (Check-up 35)',
  'Hautkrebs-Screening',
  'Vorsorge für Männer ab 45 Jahre',
  'DMP Diabetes mellitus',
  'Präoperative Untersuchungen',
  'Jugendarbeitsschutzuntersuchungen',
  'Führerscheinuntersuchung',
  'Psychosomatische Grundversorgung',
  'Reset-Therapie'
];

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const aerzte = [
  {
    name: 'Dr. Bernd Schilling',
    qualifications: ['Facharzt für Allgemeinmedizin', 'Chirotherapie'],
    image: `${baseUrl}images/team/dr-schilling-2026.webp`,
    imagePosition: 'object-[60%_top]'
  },
  {
    name: 'Julie Osmaston',
    qualifications: ['Fachärztin für Allgemeinmedizin'],
    image: `${baseUrl}images/team/j-osmaston.webp`,
    imagePosition: 'object-top'
  },
  {
    name: 'Dr. Cornelia Riesner',
    qualifications: ['Fachärztin für Allgemeinmedizin'],
    image: `${baseUrl}images/team/dr-riesner.webp`,
    imagePosition: 'object-top'
  }
];

const team = [
  'Dr. Schilling',
  'Frau Schilling',
  'Frau L. Neth',
  'Frau A. Neth',
  'Frau Merz',
  'Frau Rieger',
  'Frau Osmaston',
  'Dr. Riesner',
  'Frau Rauschenbach'
];
const teamImage = `${baseUrl}images/team/praxis-team.jpg`;
const teamImageWebpSrcset = `${baseUrl}images/team/praxis-team-1200.webp 1200w, ${baseUrl}images/team/praxis-team-2000.webp 2000w`;

const oeffnungszeiten = [
  { tag: 'Montag', zeit: '8:00 – 12:00 und 16:00 – 18:00 Uhr' },
  { tag: 'Dienstag', zeit: '8:00 – 12:00 Uhr' },
  { tag: 'Mittwoch', zeit: '8:00 – 12:00 und 16:00 – 18:00 Uhr' },
  { tag: 'Donnerstag', zeit: '8:00 – 12:00 Uhr' },
  { tag: 'Freitag', zeit: '8:00 – 12:00 und 15:00 – 16:00 Uhr' }
];

const notfall = [
  { label: 'Notarzt / Rettungsdienst', nummer: '112' },
  { label: 'Ärztlicher Bereitschaftsdienst', nummer: '116 117' },
  { label: 'Apothekenbereitschaft', nummer: '0800 0022833' },
  { label: 'Giftnotruf Baden-Württemberg', nummer: '0761 19240' }
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'MedicalClinic',
  '@id': `${praxis.website}/#medical-clinic`,
  name: praxis.shortName,
  legalName: praxis.legalName,
  alternateName: 'Hausarztpraxis Dr. Bernd Schilling',
  url: praxis.website,
  telephone: praxis.phoneTel,
  image: `${praxis.website}/images/team/praxis-team.jpg`,
  logo: `${praxis.website}/logo.svg`,
  description:
    'Hausärztliche Versorgung für Menschen jeden Alters in Gomaringen mit Manueller Medizin als zusätzlichem Angebot.',
  medicalSpecialty: 'https://schema.org/PrimaryCare',
  address: {
    '@type': 'PostalAddress',
    streetAddress: praxis.street,
    postalCode: praxis.zip,
    addressLocality: praxis.city,
    addressCountry: 'DE'
  },
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'https://schema.org/Monday', opens: '08:00', closes: '12:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'https://schema.org/Monday', opens: '16:00', closes: '18:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'https://schema.org/Tuesday', opens: '08:00', closes: '12:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'https://schema.org/Wednesday', opens: '08:00', closes: '12:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'https://schema.org/Wednesday', opens: '16:00', closes: '18:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'https://schema.org/Thursday', opens: '08:00', closes: '12:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'https://schema.org/Friday', opens: '08:00', closes: '12:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'https://schema.org/Friday', opens: '15:00', closes: '16:00' }
  ],
  specialOpeningHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      validFrom: '2026-09-25',
      validThrough: '2026-09-25',
      opens: '00:00',
      closes: '00:00'
    }
  ]
};
---

<MainLayout structuredData={structuredData}>
  <header class="site-header sticky top-0 z-50 border-b border-[color:var(--line)] text-praxis-deep shadow-sm">
    <div class="section-pad flex items-center justify-between gap-2 py-3.5 sm:gap-4">
      <a href="#start" class="brand-font whitespace-nowrap text-lg font-semibold tracking-tight text-praxis-deep sm:text-xl">
        MVZ Gomaringen
      </a>
      <nav class="hidden items-center gap-7 text-sm font-semibold text-praxis-ink lg:flex" aria-label="Hauptnavigation">
        <a href="#schwerpunkt" class="link-underline hover:text-praxis-accent">Schwerpunkt</a>
        <a href="#manuelle-medizin" class="link-underline hover:text-praxis-accent">Manuelle Medizin</a>
        <a href="#leistungen" class="link-underline hover:text-praxis-accent">Leistungen</a>
        <a href="#team" class="link-underline hover:text-praxis-accent">Team</a>
        <a href="#termin" class="link-underline hover:text-praxis-accent">Termin</a>
        <a href="#leitbild" class="link-underline hover:text-praxis-accent">Leitbild</a>
        <a href="#kontakt" class="link-underline hover:text-praxis-accent">Kontakt</a>
      </nav>
      <div class="flex shrink-0 items-center gap-2">
        <a
          href="tel:+4970727031"
          aria-label="Praxis anrufen: 07072 / 7031"
          class="flex h-10 items-center justify-center rounded-md bg-praxis-deep px-3 text-sm font-semibold text-white transition hover:bg-praxis-mid sm:h-auto sm:px-3.5 sm:py-2"
        >
          <svg class="h-5 w-5 sm:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106a1.125 1.125 0 0 0-1.173.417l-.97 1.293a1.125 1.125 0 0 1-1.21.38 12.035 12.035 0 0 1-7.143-7.143 1.125 1.125 0 0 1 .38-1.21l1.293-.97c.363-.272.526-.739.417-1.173L6.963 3.102A1.125 1.125 0 0 0 5.872 2.25H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
          </svg>
          <span class="hidden sm:inline">07072 / 7031</span>
        </a>

        <details id="mobile-navigation" class="group relative lg:hidden">
          <summary
            class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-md border border-[color:var(--line)] bg-white text-praxis-deep transition hover:border-praxis-accent hover:text-praxis-accent [&::-webkit-details-marker]:hidden"
            aria-label="Navigation öffnen"
            aria-expanded="false"
          >
            <svg class="h-5 w-5 group-open:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <svg class="hidden h-5 w-5 group-open:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" d="M6 6l12 12M18 6 6 18" />
            </svg>
          </summary>
          <nav
            class="absolute right-0 top-full mt-3 w-64 overflow-hidden rounded-md border border-[color:var(--line)] bg-white p-2 text-sm font-semibold text-praxis-ink shadow-lift"
            aria-label="Mobile Navigation"
          >
            <a href="#schwerpunkt" class="block rounded px-4 py-3 hover:bg-praxis-mist hover:text-praxis-accent">Schwerpunkt</a>
            <a href="#manuelle-medizin" class="block rounded px-4 py-3 hover:bg-praxis-mist hover:text-praxis-accent">Manuelle Medizin</a>
            <a href="#leistungen" class="block rounded px-4 py-3 hover:bg-praxis-mist hover:text-praxis-accent">Leistungen</a>
            <a href="#team" class="block rounded px-4 py-3 hover:bg-praxis-mist hover:text-praxis-accent">Team</a>
            <a href="#termin" class="block rounded px-4 py-3 hover:bg-praxis-mist hover:text-praxis-accent">Termin</a>
            <a href="#leitbild" class="block rounded px-4 py-3 hover:bg-praxis-mist hover:text-praxis-accent">Leitbild</a>
            <a href="#kontakt" class="block rounded px-4 py-3 hover:bg-praxis-mist hover:text-praxis-accent">Kontakt</a>
          </nav>
        </details>
      </div>
    </div>
  </header>

  <script>
    const mobileNavigation = document.getElementById('mobile-navigation');
    const mobileNavigationToggle = mobileNavigation?.querySelector('summary');

    mobileNavigation?.addEventListener('toggle', () => {
      const isOpen = mobileNavigation.hasAttribute('open');
      mobileNavigationToggle?.setAttribute('aria-expanded', String(isOpen));
      mobileNavigationToggle?.setAttribute('aria-label', isOpen ? 'Navigation schließen' : 'Navigation öffnen');
    });

    mobileNavigation?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => mobileNavigation.removeAttribute('open'));
    });

    document.addEventListener('click', (event) => {
      if (mobileNavigation?.hasAttribute('open') && !mobileNavigation.contains(event.target as Node)) {
        mobileNavigation.removeAttribute('open');
      }
    });
  </script>

  <main id="start">
    <section
      class="border-b border-praxis-highlight/40 bg-praxis-highlight/15"
      aria-label="Aktuelle Hinweise"
      data-hinweise
      hidden={!hinweise.some((hinweis) => istAktuell(hinweis.sichtbarAb, hinweis.sichtbarBis))}
    >
      <div class="section-pad py-4 sm:py-5">
        {
          hinweise.map((hinweis) => (
            <article
              class="flex gap-3 border-l-4 border-praxis-highlight pl-4 sm:items-center sm:gap-4 sm:pl-5"
              data-hinweis
              data-sichtbar-ab={hinweis.sichtbarAb}
              data-sichtbar-bis={hinweis.sichtbarBis}
              hidden={!istAktuell(hinweis.sichtbarAb, hinweis.sichtbarBis)}
            >
              <svg
                class="mt-0.5 h-5 w-5 shrink-0 text-praxis-deep sm:mt-0 sm:h-6 sm:w-6"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <circle cx="12" cy="12" r="9" />
                <path stroke-linecap="round" d="M12 10v6m0-9h.01" />
              </svg>
              <div class="sm:flex sm:items-baseline sm:gap-3">
                <h2 class="text-base font-semibold text-praxis-deep sm:shrink-0">{hinweis.titel}</h2>
                <p class="mt-1 text-sm leading-relaxed text-[color:var(--text-soft)] sm:mt-0 sm:text-base">
                  {hinweis.text}
                </p>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <script is:inline>
      (() => {
        const bereich = document.querySelector('[data-hinweise]');
        const jetzt = Date.now();
        let hatAktuelleHinweise = false;

        bereich?.querySelectorAll('[data-hinweis]').forEach((hinweis) => {
          const sichtbarAb = Date.parse(hinweis.getAttribute('data-sichtbar-ab') ?? '');
          const sichtbarBis = Date.parse(hinweis.getAttribute('data-sichtbar-bis') ?? '');
          const istSichtbar = jetzt >= sichtbarAb && jetzt < sichtbarBis;

          hinweis.toggleAttribute('hidden', !istSichtbar);
          hatAktuelleHinweise ||= istSichtbar;
        });

        bereich?.toggleAttribute('hidden', !hatAktuelleHinweise);
      })();
    </script>

    <!-- Hero: Ortsfoto vollflächig, Brand zuerst -->
    <section class="relative min-h-[88vh] overflow-hidden bg-praxis-deep text-white">
      <picture>
        <source
          type="image/webp"
          srcset={`${baseUrl}images/hero/gomaringen-tal-1600.webp 1600w, ${baseUrl}images/hero/gomaringen-tal-2400.webp 2400w`}
          sizes="(max-width: 640px) 1400px, 100vw"
        />
        <img
          class="hero-photo absolute inset-0 h-full w-full scale-105 object-cover object-[center_38%]"
          src={`${baseUrl}images/hero/gomaringen-tal.jpg`}
          alt="Blick über Gomaringen am Morgen"
          width="3976"
          height="2081"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
      <div class="hero-scrim pointer-events-none absolute inset-0" aria-hidden="true"></div>

      <div class="section-pad relative flex min-h-[88vh] flex-col justify-center py-28 sm:py-32">
        <div class="hero-copy max-w-3xl">
          <p class="brand-font text-4xl font-semibold tracking-tight text-white sm:text-5xl lg:text-6xl">
            MVZ Gomaringen
          </p>
          <p class="mt-4 text-base font-medium text-white/90 sm:text-lg">
            der MED-GO e.G. · Hausarztpraxis Dr. Bernd Schilling
          </p>
          <h1 class="mt-8 text-2xl font-medium leading-snug text-white sm:text-3xl lg:text-[2.15rem] lg:leading-snug">
            Hausärztliche Versorgung für Menschen jeden Alters – Manuelle Medizin
          </h1>
          <p class="mt-5 text-lg font-medium leading-relaxed text-white sm:text-xl">
            Schön, dass Sie uns gefunden haben!
          </p>
          <p class="mt-2 text-base leading-relaxed text-white/85 sm:text-lg">
            Wir begleiten Menschen in jeder Lebenslage, oft über Jahrzehnte.
          </p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a
              href="tel:+4970727031"
              class="rounded-md bg-white px-5 py-3 text-sm font-semibold text-praxis-deep shadow-lift transition hover:bg-praxis-soft"
            >
              Termin telefonisch vereinbaren
            </a>
            <a
              href="#oeffnungszeiten"
              class="rounded-md border border-white/45 px-5 py-3 text-sm font-semibold text-white transition hover:border-white hover:bg-white/10"
            >
              Öffnungszeiten
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Schwerpunkt -->
    <section id="schwerpunkt" class="border-y border-[color:var(--line)] bg-white/50">
      <div class="section-pad py-20 sm:py-24">
        <p class="text-sm font-semibold uppercase tracking-[0.14em] text-praxis-accent">Unser Schwerpunkt</p>
        <h2 class="mt-3 max-w-3xl text-3xl font-semibold text-praxis-deep sm:text-4xl">
          Hausärztliche Versorgung für Menschen jeden Alters
        </h2>
        <p class="mt-5 max-w-3xl text-lg leading-relaxed text-[color:var(--text-soft)]">
          Im Mittelpunkt stehen Sie und Ihre Gesundheit – von der Vorsorge über akute Beschwerden bis zur
          langfristigen Begleitung chronischer Erkrankungen. Wir sind Ihre erste Anlaufstelle im Alltag und kennen
          oft die Geschichte hinter dem aktuellen Anliegen.
        </p>
      </div>
    </section>

    <!-- Manuelle Medizin – Besonderheit -->
    <section id="manuelle-medizin" class="relative overflow-hidden bg-praxis-deep text-white">
      <div
        class="pointer-events-none absolute -left-20 top-0 h-72 w-72 rounded-full bg-[radial-gradient(circle,rgba(47,111,122,0.45),transparent_70%)]"
        aria-hidden="true"
      ></div>
      <div
        class="pointer-events-none absolute bottom-0 right-0 h-80 w-80 rounded-full bg-[radial-gradient(circle,rgba(196,163,90,0.2),transparent_70%)]"
        aria-hidden="true"
      ></div>

      <div class="section-pad relative grid gap-10 py-20 sm:py-24 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.14em] text-praxis-highlight">
            Besonders bei uns
          </p>
          <h2 class="mt-3 text-3xl font-semibold sm:text-4xl">Manuelle Medizin</h2>
          <p class="mt-5 max-w-xl text-lg leading-relaxed text-white/80">
            Zusätzlich zur hausärztlichen Versorgung bieten wir Manuelle Medizin an. Blockaden, Verspannungen und Funktionsstörungen behandeln wir mit
            gezielten, schonenden Techniken.
          </p>
          <p class="mt-4 max-w-xl leading-relaxed text-white/70">
            Sprechen Sie uns an, wenn Beschwerden am
            Bewegungsapparat Sie belasten – wir prüfen gemeinsam, was für Sie passt.
          </p>
        </div>

        <aside class="border border-white/15 bg-white/5 p-7 backdrop-blur-sm">
          <h3 class="text-xl font-semibold">Was Sie erwarten können</h3>
          <ul class="mt-5 space-y-4 text-white/80">
            <li class="flex gap-3">
              <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-praxis-highlight"></span>
              <span>Reset-Therapie als besondere Kompetenz unserer Praxis</span>
            </li>
            <li class="flex gap-3">
              <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-praxis-highlight"></span>
              <span>Individuelle Untersuchung mit Blick auf Haltung, Bewegung und Beschwerdebild</span>
            </li>
          </ul>
          <a
            href="tel:+4970727031"
            class="mt-8 inline-flex rounded-md bg-praxis-highlight px-4 py-2.5 text-sm font-semibold text-praxis-deep transition hover:brightness-110"
          >
            Termin telefonisch vereinbaren
          </a>
        </aside>
      </div>
    </section>

    <!-- Leistungen -->
    <section id="leistungen" class="section-pad py-20 sm:py-24">
      <p class="text-sm font-semibold uppercase tracking-[0.14em] text-praxis-accent">Ärztliche Leistungen</p>
      <h2 class="mt-3 text-3xl font-semibold text-praxis-deep sm:text-4xl">Unser Leistungsspektrum</h2>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-[color:var(--text-soft)]">
        Von Vorsorge und Diagnostik bis zur psychosomatischen und chronischen Betreuung – ein Überblick über
        unser Spektrum in der hausärztlichen Versorgung.
      </p>

      <ul class="mt-10 grid gap-x-10 gap-y-5 border-t border-[color:var(--line)] pt-8 sm:grid-cols-2 lg:grid-cols-3">
        {
          leistungen.map((item) => (
            <li class="flex items-start gap-3 text-[color:var(--text-soft)]">
              <svg
                class="mt-0.5 h-5 w-5 shrink-0 text-praxis-mid"
                viewBox="0 0 20 20"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                aria-hidden="true"
              >
                <circle cx="10" cy="10" r="8" />
                <path stroke-linecap="round" stroke-linejoin="round" d="m6.75 10.25 2 2 4.5-4.5" />
              </svg>
              <span class="leading-relaxed">{item}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Team -->
    <section id="team" class="border-y border-[color:var(--line)] bg-white/50">
      <div class="section-pad py-20 sm:py-24">
        <div class="grid gap-10 lg:grid-cols-[0.72fr_1.28fr] lg:items-center lg:gap-14">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.14em] text-praxis-accent">Menschen vor Ort</p>
            <h2 class="mt-3 text-3xl font-semibold text-praxis-deep sm:text-4xl">Ärztinnen, Ärzte und Team</h2>
            <p class="mt-4 text-lg leading-relaxed text-[color:var(--text-soft)]">
              Als eingespieltes Praxisteam begleiten wir Patientinnen und Patienten oft über viele Jahre.
            </p>
          </div>

          <figure>
            <div class="overflow-hidden bg-praxis-mist">
              <picture>
                <source type="image/webp" srcset={teamImageWebpSrcset} sizes="(max-width: 1024px) 100vw, 720px" />
                <img
                  src={teamImage}
                  alt={`Das gesamte Praxisteam des MVZ Gomaringen vor der Praxis. Von links nach rechts: ${team.join(', ')}.`}
                  class="h-auto w-full object-cover"
                  width="3200"
                  height="2133"
                  loading="lazy"
                  decoding="async"
                />
              </picture>
            </div>
            <figcaption class="mt-4 text-[color:var(--text-soft)]">
              <span class="font-semibold text-praxis-deep">Praxisteam</span><br />
              Von links nach rechts: {team.join(', ')}.
            </figcaption>
          </figure>
        </div>

        <h3 class="mt-16 text-xl font-semibold text-praxis-deep">Ärztliche Leitung</h3>
        <ul class="mt-6 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {
            aerzte.map((arzt) => (
              <li>
                <figure>
                  <div class="aspect-[4/5] overflow-hidden bg-praxis-mist">
                    <img
                      src={arzt.image}
                      alt={`Portrait von ${arzt.name}`}
                      class={`h-full w-full object-cover ${arzt.imagePosition}`}
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                  <figcaption class="mt-4 border-l-2 border-praxis-accent pl-4 text-praxis-deep">
                    <p class="text-lg">{arzt.name}</p>
                    {arzt.qualifications && (
                      <ul class="mt-1 space-y-0.5 text-sm leading-relaxed text-[color:var(--text-soft)]">
                        {arzt.qualifications.map((item) => (
                          <li>{item}</li>
                        ))}
                      </ul>
                    )}
                  </figcaption>
                </figure>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- Termin -->
    <section id="termin" class="section-pad py-20 sm:py-24">
      <div class="max-w-2xl">
        <p class="text-sm font-semibold uppercase tracking-[0.14em] text-praxis-accent">Terminvergabe</p>
        <h2 class="mt-3 text-3xl font-semibold text-praxis-deep sm:text-4xl">Termin vereinbaren</h2>
        <p class="mt-4 leading-relaxed text-[color:var(--text-soft)]">
          Wir sind eine Bestellpraxis – bitte vereinbaren Sie Ihren Termin immer vorab. Termine vergeben wir
          derzeit telefonisch unter
          <a href="tel:+4970727031" class="font-semibold text-praxis-deep link-underline">07072 / 7031</a>.
        </p>
        <p class="mt-4 leading-relaxed text-[color:var(--text-soft)]">
          Wiederholungsrezepte und Überweisungen können Sie telefonisch anfordern und in der Regel am Folgetag
          abholen.
        </p>
        <a
          href="tel:+4970727031"
          class="mt-8 inline-flex rounded-md bg-praxis-deep px-5 py-3 text-sm font-semibold text-white transition hover:bg-praxis-mid"
        >
          Jetzt anrufen: 07072 / 7031
        </a>
      </div>
    </section>

    <!-- Leitbild -->
    <section id="leitbild" class="section-pad py-20 sm:py-24">
      <p class="text-sm font-semibold uppercase tracking-[0.14em] text-praxis-accent">Unser Leitbild</p>
      <h2 class="mt-3 max-w-2xl text-3xl font-semibold text-praxis-deep sm:text-4xl">
        Was uns als Praxis ausmacht
      </h2>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-[color:var(--text-soft)]">
        Für alle, die mehr über unsere Haltung wissen möchten: Vier Grundsätze begleiten unsere Arbeit –
        vom ersten Gespräch bis zur langfristigen Betreuung.
      </p>

      <div class="mt-12 grid gap-10 md:grid-cols-2">
        {
          leitbild.map((item, index) => (
            <article class="border-t border-[color:var(--line)] pt-6">
              <span class="text-sm font-semibold text-praxis-accent">0{index + 1}</span>
              <h3 class="mt-2 text-2xl font-semibold text-praxis-deep">{item.title}</h3>
              <p class="mt-4 leading-relaxed text-[color:var(--text-soft)]">{item.text}</p>
            </article>
          ))
        }
      </div>
    </section>

    <!-- Kontakt & Zeiten -->
    <section id="kontakt" class="border-t border-[color:var(--line)] bg-[color:var(--bg-deep)] text-white">
      <div class="section-pad grid gap-12 py-20 sm:py-24 lg:grid-cols-3">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.14em] text-praxis-highlight">Kontakt</p>
          <h2 class="mt-3 text-3xl font-semibold">So erreichen Sie uns</h2>
          <address class="mt-6 not-italic leading-relaxed text-white/80">
            MVZ Gomaringen der MED-GO e.G.<br />
            Lindenstraße 84/1<br />
            72810 Gomaringen
          </address>
          <p class="mt-5 space-y-1 text-white/80">
            <a href="tel:+4970727031" class="block font-semibold text-white link-underline">Telefon: 07072 / 7031</a>
            <span class="block">Fax: 07072 / 912690</span>
          </p>

          <div class="mt-8 border-t border-white/10 pt-6">
            <h3 class="text-xl font-semibold">Anfahrt & Parken</h3>
            <p class="mt-3 text-sm leading-relaxed text-white/75">
              Die Zufahrt zur Praxis erfolgt über die Lindenstraße. Patientenparkplätze befinden sich im
              Innenhof entlang der Zufahrt. Der Praxiseingang liegt am Ende des Hofbereichs und ist
              barrierefrei zugänglich.
            </p>
            <a
              href="https://www.google.de/maps/place/Dr.med.+Bernd+Schilling/@48.4559471,9.100379,68m/data=!3m1!1e3!4m14!1m7!3m6!1s0x4799f0bee7475661:0xfeaafcb3fac02fcc!2sDr.med.+Bernd+Schilling!8m2!3d48.4559661!4d9.1008052!16s%2Fg%2F1vfp74xh!3m5!1s0x4799f0bee7475661:0xfeaafcb3fac02fcc!8m2!3d48.4559661!4d9.1008052!16s%2Fg%2F1vfp74xh?entry=ttu&amp;g_ep=EgoyMDI2MDkwOS4wIKXMDSoASAFQAw%3D%3D"
              class="mt-5 inline-flex items-center gap-2 rounded-md border border-white/35 px-4 py-2.5 text-sm font-semibold text-white transition hover:border-white hover:bg-white/10"
              target="_blank"
              rel="noopener noreferrer"
            >
              Route in Google Maps öffnen
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H18m0 0v4.5M18 6l-7.5 7.5M15 13.5V18H6V9h4.5" />
              </svg>
            </a>
          </div>
        </div>

        <div id="oeffnungszeiten" class="scroll-mt-24">
          <h3 class="text-xl font-semibold">Öffnungszeiten</h3>
          <dl class="mt-5 space-y-3 text-sm">
            {
              oeffnungszeiten.map((eintrag) => (
                <div class="grid grid-cols-[7rem_1fr] gap-2 border-b border-white/10 pb-2">
                  <dt class="font-semibold text-white">{eintrag.tag}</dt>
                  <dd class="text-white/75">{eintrag.zeit}</dd>
                </div>
              ))
            }
          </dl>
          <p class="mt-4 text-sm text-white/65">Bitte immer vorab einen Termin vereinbaren.</p>
        </div>

        <div>
          <h3 class="text-xl font-semibold">Im Notfall</h3>
          <ul class="mt-5 space-y-3 text-sm">
            {
              notfall.map((eintrag) => (
                <li class="border-b border-white/10 pb-2">
                  <p class="text-white/65">{eintrag.label}</p>
                  <a
                    href={`tel:${eintrag.nummer.replace(/\s/g, '')}`}
                    class="font-semibold text-white link-underline"
                  >
                    {eintrag.nummer}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <div class="border-t border-white/10">
        <div class="section-pad flex flex-col gap-3 py-6 text-sm text-white/55 sm:flex-row sm:items-center sm:justify-between">
          <p>© {new Date().getFullYear()} MVZ Gomaringen der MED-GO e.G.</p>
          <nav class="flex flex-wrap gap-x-5 gap-y-2" aria-label="Rechtliche Hinweise">
            <a href={`${baseUrl}impressum/`} class="text-white/70 link-underline hover:text-white">Impressum</a>
            <a href={`${baseUrl}datenschutz/`} class="text-white/70 link-underline hover:text-white">Datenschutz</a>
          </nav>
        </div>
      </div>
    </section>
  </main>
</MainLayout>
