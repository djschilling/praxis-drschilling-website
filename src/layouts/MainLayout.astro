---
import '../styles/global.css';
import { praxis } from '../data/praxis';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogImageType?: string;
  ogType?: 'website' | 'article';
  structuredData?: Record<string, unknown>;
}

const {
  title = 'MVZ Gomaringen – Hausarztpraxis Dr. Bernd Schilling',
  description =
    'MVZ Gomaringen der MED-GO e.G.: Hausärztliche Grundversorgung · Familienmedizin in der Lindenstraße 84/1 – mit Manueller Medizin als besonderem Angebot.',
  ogImageAlt = 'MVZ Gomaringen mit dem Praxisteam',
  ogImageWidth = 1200,
  ogImageHeight = 630,
  ogImageType = 'image/jpeg',
  ogType = 'website',
  structuredData
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const faviconHref = `${baseUrl}favicon.svg`;

const siteOrigin = (Astro.site?.origin ?? praxis.website).replace(/\/$/, '');
const canonicalURL = new URL(Astro.url.pathname, `${siteOrigin}/`);
const defaultOgImage = new URL(`${baseUrl}images/social/mvz-gomaringen-team-og.jpg`, `${siteOrigin}/`);
const ogImageURL = Astro.props.ogImage
  ? new URL(Astro.props.ogImage, `${siteOrigin}/`)
  : defaultOgImage;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#164039" />
    <link rel="canonical" href={canonicalURL.href} />
    <link rel="icon" type="image/svg+xml" href={faviconHref} />
    <title>{title}</title>

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content={praxis.shortName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content={ogImageURL.href} />
    <meta property="og:image:secure_url" content={ogImageURL.href} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:width" content={ogImageWidth} />
    <meta property="og:image:height" content={ogImageHeight} />
    <meta property="og:image:alt" content={ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL.href} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {
      structuredData && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(structuredData)}
        />
      )
    }

    <script
      is:inline
      defer
      src="https://umami.davidschilling.de/script.js"
      data-website-id="6497af2c-a71e-4561-bc8b-7e0784283743"
      data-domains="mvz-gomaringen.de,www.mvz-gomaringen.de"
      data-do-not-track="true"
      data-exclude-search="true"
      data-exclude-hash="true"
    ></script>
  </head>
  <body>
    <slot />
  </body>
</html>
