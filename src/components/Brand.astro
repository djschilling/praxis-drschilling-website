---
import ChristmasEgg from './ChristmasEgg.astro';

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const { href = baseUrl } = Astro.props;
---

<div class="relative min-w-0">
  <a href={href} class="brand-lockup text-praxis-deep" aria-label="MVZ Gomaringen – Startseite">
    <img src={`${baseUrl}images/brand/landschaft-c.png`} width="528" height="382" alt="" class="brand-mark" />
    <span class="brand-copy">
      <span class="brand-name">MVZ Gomaringen</span>
      <span class="brand-practice">Praxis Dr. Schilling · Hausarzt</span>
    </span>
  </a>
  <ChristmasEgg />
</div>
